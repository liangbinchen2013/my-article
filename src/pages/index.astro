---
import PostList from '../components/PostList.astro';
import { site } from '../config';
import { categories } from '../data/categories';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, getReadingStats } from '../lib/posts';

const posts = await getPublishedPosts();
const latestDate = posts[0]?.data.pubDate;
const totalWords = posts.reduce((total, post) => total + getReadingStats(post.body).words, 0);
const formattedTotalWords = new Intl.NumberFormat('zh-CN').format(totalWords);
---

<BaseLayout active="all">
  <section class="hero">
    <p class="eyebrow">{site.intro.eyebrow}</p>
    <h1 class="hero-title">
      把散落的素材，<br class="hero-br" />收拢成可以动笔的文章。
    </h1>
    <div class="hero-copy">
      {site.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="hero-stats">
      <span><strong>{posts.length}</strong> 篇文章</span>
      <span><strong>{categories.length}</strong> 个分类</span>
      <span><strong>{formattedTotalWords}</strong> 个字</span>
      {latestDate && <span>更新于 {formatDate(latestDate)}</span>}
    </div>
  </section>

  <div class="index-head">
    <h2>全部文章</h2>
    <p>按时间倒序 · 共 {posts.length} 篇</p>
  </div>

  <PostList posts={posts} emptyText="素材库还是空的。写下第一篇，从这里开始。" />
</BaseLayout>
