---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<button
  class:list={['theme-toggle', compact && 'theme-toggle--compact']}
  type="button"
  data-theme-toggle
  aria-label="切换深浅色主题"
  title="切换深浅色主题"
>
  <span class="theme-toggle-icon" aria-hidden="true">
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
    </svg>
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.2 14.6A8.2 8.2 0 0 1 9.4 3.8 8.4 8.4 0 1 0 20.2 14.6Z"></path>
    </svg>
  </span>
  {!compact && <span class="theme-toggle-label" data-theme-label>深色模式</span>}
</button>
